{
  "name": "unifi-protect-assistant",
  "version": "1.0.0",
  "description": "Normalized person/face recognition storage and dashboard served from Cloudflare Workers + D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/*.integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "git config core.hooksPath .githooks || true",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "access:configure": "node scripts/configure-cloudflare-access.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240529.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^1.6.0",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@honeybadger-io/cloudflare": "^0.3.3",
    "jose": "^6.2.8"
  }
}
