{
  "name": "unifi-protect-assistant",
  "version": "1.0.0",
  "description": "Normalized person/face recognition storage and dashboard served from Cloudflare Workers + D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240529.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.6",
    "better-auth": "^1.6.23"
  }
}
