# Copy to `.env` for Cloudflare CLI / Access provisioning (`npm run access:configure`, wrangler).
# Copy Worker secret lines to `.dev.vars` for `wrangler dev` (Wrangler loads `.dev.vars`, not `.env`).
# Never commit real values.

# --- Cloudflare API (provisioning / deploy only; not Worker runtime) ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# --- Access allowlist (Access policy + Worker JWT; also set as a Worker secret) ---
ALLOWED_EMAILS=you@example.com,other@example.com

# --- Worker secrets (put these in `.dev.vars` for local `wrangler dev`) ---
WEBHOOK_SECRET=your_dev_shared_webhook_secret
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=your_access_application_aud_tag
HONEYBADGER_API_KEY=your_honeybadger_api_key

# Local UI / webhook only — never enable in production:
# ALLOW_LOCAL_AUTH_BYPASS=true
# ALLOW_INSECURE_WEBHOOKS=true
